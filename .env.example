# Same Postgres instance the `butter` repo uses — this app reads listings
# and writes buyer_interest rows against the same database.
DATABASE_URL=

NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Where seller login and the workbench live (same origin, /login is a
# path there) — cross-domain links only, this app never renders those
# pages itself.
NEXT_PUBLIC_APP_URL=https://app.trybutter.ai

NEXT_PUBLIC_SITE_URL=https://marketplace.trybutter.ai

# ── Footage storage ──
# The bucket the seller app uploads recordings to. The buyer portal reads
# from it and never writes, so a read-only key is enough and is what these
# should hold. Leave them blank and the portal still lists everything that
# was collected; the players and download links say footage can't be opened
# rather than failing the page.
# S3_ENDPOINT is only set for an S3-compatible provider that is not AWS.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
